# Optional: cloud sync via your own Supabase project.
# Without these, the app runs fully offline (IndexedDB), and a Supabase URL/key can
# also be entered at runtime in the "Cloud" dialog. Run supabase/schema.sql once first.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
